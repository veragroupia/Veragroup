---
/* Banner de cookies. Só aparece quando existe GA4/GTM configurado:
   sem ferramenta de medição, o site não grava cookie nenhum. */
import { empresa } from '../data/empresa';
const { ga4, gtm } = empresa.analytics;
const ferramenta = gtm ? 'Google Tag Manager' : 'Google Analytics';
---
<div class="cookies" data-cookies data-ga4={ga4} data-gtm={gtm} role="region" aria-label="Aviso de cookies" hidden>
  <p>
    Se você aceitar, ligamos a medição de visitas ({ferramenta}) para saber quais botões funcionam. Sem o seu ok,
    nada é medido. <a href="/privacidade">Política de privacidade</a>
  </p>
  <div class="cookies__botoes">
    <button type="button" class="btn btn--linha btn--p" data-cookies-recusar>Recusar</button>
    <button type="button" class="btn btn--tinta btn--p" data-cookies-aceitar>Aceitar</button>
  </div>
</div>

<style>
  .cookies {
    position: fixed;
    z-index: 90;
    left: 12px;
    right: 12px;
    bottom: 12px;
    display: grid;
    gap: 14px;
    max-width: 560px;
    padding: 18px;
    border: 1px solid var(--tinta);
    border-radius: 14px;
    background: var(--papel);
    box-shadow: 0 20px 40px -24px rgb(14 14 12 / 0.5);
    font-size: 14.5px;
    line-height: 1.45;
  }
  .cookies[hidden] {
    display: none;
  }
  .cookies__botoes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  @media (min-width: 640px) {
    .cookies {
      left: 24px;
      bottom: 24px;
    }
  }
</style>
