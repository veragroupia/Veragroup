---
import Button from '../ui/Button.astro';
import Icon, { type IconName } from '../ui/Icon.astro';

const itensFicha: { rotulo: string; icone: IconName }[] = [
  { rotulo: 'Fotos da loja', icone: 'camera' },
  { rotulo: 'Horário certo', icone: 'relogio' },
  { rotulo: 'Rota até a porta', icone: 'rota' },
  { rotulo: 'Site próprio', icone: 'site' },
  { rotulo: 'Botão de WhatsApp', icone: 'whatsapp' },
  { rotulo: 'Avaliações recentes', icone: 'estrela' },
];

const mudancas: { titulo: string; texto: string; icone: IconName }[] = [
  { titulo: 'Achado no Google Maps', texto: 'Com foto, horário e rota, quando procuram perto de você.', icone: 'mapa' },
  { titulo: 'Pedido chega pronto', texto: 'No WhatsApp, com item, quantidade e total. Sem ida e volta.', icone: 'whatsapp' },
  { titulo: 'Vendendo com a porta fechada', texto: 'Loja virtual aceitando Pix de noite e no domingo.', icone: 'loja' },
  { titulo: 'Avaliação com um toque', texto: 'O cliente aproxima o celular da plaquinha no balcão.', icone: 'nfc' },
];
---

<section class="secao" aria-labelledby="potencial-titulo">
  <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-6 lg:order-2">
      <header data-reveal>
        <p class="eyebrow">O potencial</p>
        <h2 id="potencial-titulo" class="mt-3 text-display-xl">Com o digital arrumado, o cliente chega até você.</h2>
        <p class="mt-4 text-body-lg text-muted">Não é mágica nem promessa de primeiro lugar. É deixar tudo no lugar para quem já está procurando.</p>
      </header>
      <ul class="mt-8 grid gap-5">
        {
          mudancas.map((m) => (
            <li class="flex gap-4" data-reveal>
              <span class="grid size-11 flex-none place-items-center rounded-md bg-accent-2-tint text-accent-2-strong">
                <Icon name={m.icone} size={22} />
              </span>
              <div>
                <h3 class="text-title font-semibold">{m.titulo}</h3>
                <p class="mt-1 text-muted">{m.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="mt-10" data-reveal data-sem-flutuante>
        <Button variant="whatsapp" size="lg" whatsapp="Olá! Vim pelo site e quero um diagnóstico gratuito para ver o que dá para melhorar no meu negócio.">
          Quero um diagnóstico gratuito
        </Button>
      </div>
    </div>

    <div class="lg:col-span-6 lg:order-1" data-reveal>
      <div class="ficha card mx-auto max-w-[26rem] p-5 md:p-6" data-ficha data-estado="organizado">
        <div class="ficha-alternar" role="group" aria-label="Comparar como o cliente vê a sua loja" data-ficha-botoes hidden>
          <button type="button" data-estado-botao="hoje" aria-pressed="false">Hoje</button>
          <button type="button" data-estado-botao="organizado" aria-pressed="true">Organizado</button>
        </div>

        <div class="ficha-capa mt-4" aria-hidden="true">
          <div class="ficha-foto ficha-foto-1"></div>
          <div class="ficha-foto ficha-foto-2"></div>
          <div class="ficha-foto ficha-foto-3"></div>
          <span class="ficha-sem-foto">Sem fotos</span>
        </div>

        <div class="mt-4 flex items-start justify-between gap-3">
          <div>
            <p class="font-display text-title font-semibold" data-p-empresa>Sua loja</p>
            <p class="text-small text-stone">Comércio local · <span data-p-cidade>sua cidade</span></p>
          </div>
          <p class="ficha-status text-small font-semibold">
            <span class="so-organizado text-accent-2-strong">Aberto agora</span>
            <span class="so-hoje text-warn-strong">Horário?</span>
          </p>
        </div>

        <p class="mt-2 flex items-center gap-2 text-small">
          <span class="ficha-estrelas" aria-hidden="true">★★★★★</span>
          <span class="so-organizado text-stone">Avaliações recentes</span>
          <span class="so-hoje text-stone">Sem avaliações recentes</span>
        </p>

        <div class="ficha-acoes mt-4" aria-hidden="true">
          <span><Icon name="rota" size={18} />Rota</span>
          <span><Icon name="site" size={18} />Site</span>
          <span class="ficha-acao-wa"><Icon name="whatsapp" size={18} />WhatsApp</span>
        </div>

        <ul class="mt-5 grid gap-2 border-t border-line pt-4" aria-live="polite">
          {
            itensFicha.map((item) => (
              <li class="ficha-item flex items-center justify-between gap-3 text-small">
                <span class="inline-flex items-center gap-2">
                  <Icon name={item.icone} size={18} class="text-stone" />
                  {item.rotulo}
                </span>
                <span class="ficha-marca">
                  <span class="so-organizado inline-flex items-center gap-1 font-semibold text-accent-2-strong">
                    <Icon name="check" size={16} />
                    Tem
                  </span>
                  <span class="so-hoje inline-flex items-center gap-1 font-semibold text-warn-strong">
                    <Icon name="x" size={16} />
                    Falta
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ficha-alternar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-paper-2);
  }
  .ficha-alternar button {
    min-height: 2.75rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    transition:
      background-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }
  .ficha-alternar button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: var(--shadow-1);
  }
  .ficha-alternar button:not([aria-pressed='true']):hover {
    background: rgb(14 17 22 / 0.06);
  }

  .ficha-capa {
    position: relative;
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 4px;
    height: 8.5rem;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-paper-2);
  }
  .ficha-foto {
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out);
  }
  .ficha-foto-1 {
    grid-row: span 2;
    background:
      radial-gradient(circle at 30% 70%, #f2a33a 0 14%, transparent 15%),
      radial-gradient(circle at 62% 64%, #e7d7c1 0 18%, transparent 19%),
      linear-gradient(180deg, #cdbfa8 0 55%, #8b6f4e 55%);
  }
  .ficha-foto-2 {
    background:
      radial-gradient(circle at 50% 60%, #7a4a2b 0 28%, transparent 29%),
      #e9dccb;
  }
  .ficha-foto-3 {
    background:
      linear-gradient(90deg, transparent 0 20%, #2f6bff 20% 28%, transparent 28%),
      linear-gradient(180deg, #d9d4ca 0 60%, #b9b2a5 60%);
  }
  .ficha-sem-foto {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-stone);
    font-size: 0.875rem;
    font-weight: 600;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }
  .ficha-estrelas {
    color: #e0a02a;
    letter-spacing: 1px;
    transition:
      color var(--duration-base) var(--ease-out),
      opacity var(--duration-base) var(--ease-out);
  }
  .ficha-acoes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }
  .ficha-acoes span {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.25rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent-tint);
    color: var(--color-accent-deep);
    font-size: 0.8125rem;
    font-weight: 600;
    transition:
      background-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }
  .ficha-acoes .ficha-acao-wa {
    background: var(--color-accent-2-tint);
    color: var(--color-accent-2-strong);
  }
  .ficha-marca > span {
    transition: opacity var(--duration-base) var(--ease-out);
  }

  /* Estado "organizado" (padrão, e o que aparece sem JS) */
  [data-estado='organizado'] .so-hoje {
    display: none;
  }
  [data-estado='hoje'] .so-organizado {
    display: none;
  }
  [data-estado='hoje'] .ficha-foto {
    opacity: 0;
    transform: scale(0.96);
  }
  [data-estado='hoje'] .ficha-sem-foto {
    opacity: 1;
  }
  [data-estado='hoje'] .ficha-estrelas {
    color: var(--color-line-strong);
    opacity: 0.6;
  }
  /* "Hoje": botões apagados, mas com texto ainda legível (contraste AA). */
  [data-estado='hoje'] .ficha-acoes span {
    background: transparent;
    color: var(--color-stone);
    outline: 1.5px dashed var(--color-line-strong);
    outline-offset: -1.5px;
  }
  .ficha-item {
    transition: transform var(--duration-base) var(--ease-out);
  }
  [data-estado='organizado'] .ficha-item {
    animation: marca-item var(--duration-base) var(--ease-out) both;
  }
  @keyframes marca-item {
    from {
      transform: translateX(-4px);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ficha]').forEach((ficha) => {
    const botoes = ficha.querySelector<HTMLElement>('[data-ficha-botoes]');
    if (!botoes) return;
    botoes.hidden = false;
    // Começa em "Hoje": a pessoa vê o problema e toca para ver a solução.
    const definir = (estado: string) => {
      ficha.dataset.estado = estado;
      botoes.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.estadoBotao === estado)));
    };
    definir('hoje');
    botoes.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-estado-botao]');
      if (b) definir(b.dataset.estadoBotao!);
    });
    // Troca sozinha uma vez, quando a ficha aparece na tela, para mostrar o contraste.
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) window.setTimeout(() => ficha.dataset.estado === 'hoje' && definir('organizado'), 1600);
      },
      { threshold: 0.6 },
    );
    io.observe(ficha);
  });
</script>
