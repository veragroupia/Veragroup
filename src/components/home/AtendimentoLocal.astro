---
import { site } from '@/config/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

// Posições reais, em escala (13,2 unidades = 1 km), herdadas do mapa do site anterior.
const cidades = [
  { nome: 'Indaiatuba', x: 786, y: 89, lado: 'esquerda' },
  { nome: 'Salto', x: 693, y: 251, lado: 'direita' },
  { nome: 'Itu', x: 677, y: 345, lado: 'direita' },
  { nome: 'Sorocaba', x: 469, y: 694, lado: 'direita' },
] as const;
---

<section class="tema-areia secao" aria-labelledby="local-titulo">
  <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-6" data-reveal>
      <p class="eyebrow">Atendimento local</p>
      <h2 id="local-titulo" class="mt-3 text-display-xl">A gente vai até a sua loja.</h2>
      <p class="mt-4 text-body-lg text-muted">
        Atendemos {site.cidades.slice(0, -1).join(', ')} e {site.cidades.at(-1)}. O diagnóstico é feito com você, no seu balcão.
      </p>
      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Cidades atendidas">
        {
          site.cidades.map((c) => (
            <li class="badge min-h-10 bg-white px-4 text-small">
              <Icon name="mapa" size={16} class="text-accent-strong" />
              {c}
            </li>
          ))
        }
      </ul>
      <div class="mt-8" data-sem-flutuante>
        <Button variant="whatsapp" size="lg" whatsapp="Olá! Quero agendar uma visita da Vera Group na minha loja para o diagnóstico gratuito.">Agendar uma visita</Button>
      </div>
    </div>

    <figure class="lg:col-span-6" data-reveal>
      <div class="mapa tema-escuro" data-mapa>
        <svg viewBox="380 20 520 740" role="img" aria-labelledby="mapa-titulo">
          <title id="mapa-titulo">Mapa com Indaiatuba, Salto, Itu e Sorocaba, as quatro cidades atendidas pela Vera Group, no interior de São Paulo.</title>
          <defs>
            <pattern id="mapa-pontos" width="26" height="26" patternUnits="userSpaceOnUse">
              <circle cx="2" cy="2" r="1.6" fill="#2a303a"></circle>
            </pattern>
          </defs>
          <rect x="380" y="20" width="520" height="740" fill="url(#mapa-pontos)"></rect>
          <path class="mapa-rota" d="M469 694 C 540 590, 640 470, 677 345 S 690 280, 693 251 S 760 150, 786 89"></path>
          {
            cidades.map((c, i) => (
              <g class="mapa-cidade" style={`--i:${i}`}>
                <circle class="mapa-ping" cx={c.x} cy={c.y} r="12" />
                <circle class="mapa-anel" cx={c.x} cy={c.y} r="20" />
                <circle class="mapa-ponto" cx={c.x} cy={c.y} r="9" />
                <text x={c.lado === 'direita' ? c.x + 32 : c.x - 32} y={c.y + 10} text-anchor={c.lado === 'direita' ? 'start' : 'end'}>
                  {c.nome}
                </text>
              </g>
            ))
          }
          <g class="mapa-escala" transform="translate(410 80)">
            <path d="M0 0 H132"></path>
            <path d="M0 -6 V6 M132 -6 V6"></path>
            <text x="66" y="-12" text-anchor="middle">10 km</text>
          </g>
        </svg>
      </div>
      <figcaption class="mt-3 text-small text-muted">Posições reais, em escala.</figcaption>
    </figure>
  </div>
</section>

<style>
  .mapa {
    max-width: 28rem;
    margin-inline: auto;
    padding: 1rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-2);
  }
  .mapa svg {
    width: 100%;
    height: auto;
  }
  .mapa-rota {
    fill: none;
    stroke: var(--color-stone-on-ink);
    stroke-width: 3;
    stroke-dasharray: 10 12;
    opacity: 0.6;
  }
  .mapa-ponto {
    fill: var(--color-accent-on-ink);
  }
  .mapa-anel {
    fill: none;
    stroke: var(--color-accent-on-ink);
    stroke-width: 2;
    opacity: 0.35;
  }
  .mapa-ping {
    fill: none;
    stroke: var(--color-accent-on-ink);
    stroke-width: 2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .mapa-cidade text {
    fill: var(--color-paper);
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.5px;
  }
  .mapa-escala path {
    fill: none;
    stroke: var(--color-stone-on-ink);
    stroke-width: 2;
  }
  .mapa-escala text {
    fill: var(--color-stone-on-ink);
    font-size: 18px;
  }
  /* Um "ping" só, quando o mapa entra na tela. Nada em loop. */
  figure:global(.is-in) .mapa-ping {
    animation: mapa-ping 600ms var(--ease-out) both;
    animation-delay: calc(300ms + var(--i) * 120ms);
  }
  @keyframes mapa-ping {
    from {
      opacity: 0.9;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3.2);
    }
  }
</style>
