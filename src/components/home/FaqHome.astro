---
import Accordion from '../ui/Accordion.astro';
import Button from '../ui/Button.astro';
import { faqHome } from '@/data/faq';
---

<section class="secao" aria-labelledby="faq-titulo">
  <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5" data-reveal>
      <p class="eyebrow">Perguntas frequentes</p>
      <h2 id="faq-titulo" class="mt-3 text-display-xl">O que todo dono pergunta antes.</h2>
      <p class="mt-4 text-body-lg text-muted">Não achou a sua dúvida? Pergunta direto pra gente.</p>
      <Button variant="secondary" class="mt-6" whatsapp="Olá! Vim pelo site da Vera Group e tenho uma dúvida." icon="whatsapp">Perguntar no WhatsApp</Button>
    </div>
    <div class="lg:col-span-7" data-reveal>
      <Accordion items={faqHome} name="faq-home" />
    </div>
  </div>
</section>
