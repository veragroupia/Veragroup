---
import Logo from './Logo.astro';
import IconeWhats from './IconeWhats.astro';
import { linkWhats, MSG } from '../lib/texto';

const links = [
  { href: '/#calculadora', texto: 'Calculadora' },
  { href: '/#construtor', texto: 'Construtor' },
  { href: '/portfolio', texto: 'Portfólio' },
  { href: '/servicos', texto: 'Serviços' },
  { href: '/#quem-somos', texto: 'Quem somos' },
  { href: '/#duvidas', texto: 'Dúvidas' },
];
const atual = Astro.url.pathname;
---
<header class="topo" data-topo data-fora-demo>
  <div class="topo__in envelope">
    <a class="marca" href="/" aria-label="Vera Group, página inicial">
      <Logo class="marca__logo" />
      <span class="marca__group">Group</span>
    </a>
    <nav class="topo__nav" aria-label="Principal">
      {links.map((l) => (
        <a href={l.href} aria-current={atual === l.href ? 'page' : undefined}>{l.texto}</a>
      ))}
    </nav>
    <a class="btn btn--tinta btn--p topo__whats" href={linkWhats(MSG.padrao)} data-whats="topo" target="_blank" rel="noopener" aria-label="Falar com a Vera no WhatsApp">
      <IconeWhats /><span>WhatsApp</span>
    </a>
    <button class="topo__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-botao>
      <span class="topo__menu-txt">Menu</span>
      <span class="topo__menu-ico" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
  <nav id="menu" class="menu" aria-label="Menu" hidden>
    <ol class="menu__lista envelope">
      {links.map((l, i) => (
        <li><a href={l.href}><span class="mono">0{i + 1}</span>{l.texto}</a></li>
      ))}
    </ol>
  </nav>
</header>

<style>
  .topo {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--papel);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .topo:global(.rolado) {
    border-bottom-color: var(--fio);
  }
  .topo__in {
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--topo);
  }
  .marca {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    margin-right: auto;
    color: var(--tinta);
    text-decoration: none;
  }
  .marca :global(.marca__logo) {
    width: 76px;
    height: auto;
    transform: translateY(2px);
  }
  .marca__group {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tinta-2);
  }
  .topo__nav {
    display: none;
  }
  .topo__whats span {
    display: none;
  }
  .topo__whats {
    width: 44px;
    min-height: 44px;
    padding: 0;
  }
  .topo__menu {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 4px 0 8px;
    border: 0;
    background: none;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .topo__menu-ico {
    display: grid;
    gap: 5px;
    width: 22px;
  }
  .topo__menu-ico i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s var(--curva);
  }
  .topo__menu[aria-expanded='true'] .topo__menu-ico i:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .topo__menu[aria-expanded='true'] .topo__menu-ico i:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }
  .menu {
    position: absolute;
    inset: 100% 0 auto 0;
    height: calc(100dvh - var(--topo));
    overflow-y: auto;
    background: var(--papel);
    border-top: 1px solid var(--fio);
  }
  .menu__lista {
    padding-block: 12px 40px;
  }
  .menu__lista a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--fio);
    font-family: var(--serif);
    font-size: 40px;
    line-height: 1;
    text-decoration: none;
  }
  .menu__lista .mono {
    color: var(--sinal-texto);
  }
  :global(.menu-aberto) body {
    overflow: hidden;
  }

  @media (min-width: 1080px) {
    .topo__nav {
      display: flex;
      gap: 28px;
      margin-right: 8px;
    }
    .topo__nav a {
      position: relative;
      padding: 8px 0;
      font-size: 14.5px;
      font-weight: 500;
      text-decoration: none;
      color: var(--tinta-2);
    }
    .topo__nav a::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 3px;
      height: 1.5px;
      background: var(--sinal);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s var(--curva);
    }
    .topo__nav a:hover::after,
    .topo__nav a[aria-current='page']::after {
      transform: none;
    }
    .topo__whats {
      width: auto;
      min-height: 42px;
      padding: 0 18px;
    }
    .topo__whats span {
      display: inline;
    }
    .topo__menu {
      display: none;
    }
  }
</style>
