---
/**
 * Imagem responsiva padrão do site: AVIF com fallback WebP, srcset,
 * width/height declarados (CLS zero) e lazy por padrão.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  eager?: boolean;
  priority?: boolean;
  class?: string;
  pictureClass?: string;
}
const { src, alt, widths, sizes, eager = false, priority = false, class: className, pictureClass } = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  formats={['avif']}
  fallbackFormat="webp"
  widths={widths.filter((w) => w <= src.width)}
  sizes={sizes}
  loading={eager || priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : undefined}
  class={className}
  pictureAttributes={{ class: pictureClass }}
/>
