---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada" description="Esta página não existe. Volte para o início da Vera Group." caminho="/404" noindex>
  <section class="secao envelope nf">
    <p class="rotulo"><b>404</b> Página não encontrada</p>
    <h1 class="display">Procurou e <em>não achou</em>.</h1>
    <p class="corpo-g">É exatamente o que a gente não quer que aconteça com o seu cliente. Esta página não existe, mas o resto do site sim.</p>
    <p><a class="btn btn--tinta btn--g" href="/">Voltar para o início</a></p>
  </section>
</Base>
<style>
  .nf {
    display: grid;
    gap: 28px;
    max-width: 900px;
  }
</style>
