---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import CaseCard from '@/components/CaseCard.astro';
import CtaFinal from '@/components/home/CtaFinal.astro';
import { breadcrumbs } from '@/lib/schema';

const cases = (await getCollection('portfolio')).sort((a, b) => a.data.ordem - b.data.ordem);
const trilha = [
  { nome: 'Início', path: '/' },
  { nome: 'Portfólio', path: '/portfolio' },
];
const mensagem = 'Olá! Vi o portfólio da Vera Group e quero conversar sobre um projeto para o meu negócio.';
---

<Base
  title="Portfólio: lojas e sistemas no interior de SP"
  description="Trabalhos da Vera Group no interior de São Paulo: a loja virtual com peças em 3D da ERK Pratas, o cardápio digital da Vó Neis e o Vera Finances."
  path="/portfolio"
  whatsapp={mensagem}
  jsonLd={[breadcrumbs(trilha)]}
>
  <section class="secao-curta">
    <div class="wrap">
      <Breadcrumb itens={trilha} />
      <div class="mt-6 max-w-[44rem]">
        <h1 class="text-display-2xl">Trabalhos reais, de negócios daqui.</h1>
        <p class="mt-5 text-body-lg text-muted">Cada projeto foi feito do zero, para o jeito de vender de cada cliente. Toque em um para ver por dentro.</p>
      </div>
    </div>
  </section>

  <section class="tema-escuro secao" aria-label="Lista de trabalhos">
    <div class="wrap">
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          cases.map((c, i) => (
            <li data-reveal>
              <CaseCard
                nome={c.data.nome}
                segmento={c.data.segmento}
                cidade={c.data.cidade}
                resumo={c.data.resumo}
                href={`/portfolio/${c.data.slug}`}
                status={c.data.status}
                servicos={c.data.servicos}
                desktop={c.data.capa.desktop}
                mobile={c.data.capa.mobile}
                altDesktop={c.data.capa.altDesktop}
                altMobile={c.data.capa.altMobile}
                headingLevel="h2"
                eager={i < 2}
              />
            </li>
          ))
        }
      </ul>
      <p class="mt-10 max-w-[36rem] text-muted">Novos trabalhos entram aqui assim que cada cliente autoriza.</p>
    </div>
  </section>

  <CtaFinal titulo="O próximo case pode ser o seu." whatsapp={mensagem} />
</Base>
